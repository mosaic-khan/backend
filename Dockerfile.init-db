# Use a lightweight base image
FROM alpine:3.15

# Install any necessary dependencies (e.g., curl, bash, etc.)
RUN apk add --no-cache bash

# Copy your shell script into the image
COPY scripts/create-tables.sh /usr/local/bin/init-db.sh

# Ensure the script has execution permissions
RUN chmod +x /usr/local/bin/init-db.sh

# Set the entrypoint to your shell script
ENTRYPOINT ["/bin/sh", "/usr/local/bin/init-db.sh"]
